{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning",
        "MassTransit": "Information"
      }
    }
  },
  "JwtOptions": {
    "Authority": "http://keycloak:8080/realms/livelearn",
    "ValidIssuer": "http://localhost:8080/realms/livelearn",
    "ValidAudience": "livelearn-spa",
    "MetadataAddress": "http://keycloak:8080/realms/livelearn/.well-known/openid-configuration",
    "AuthorizationUrl": "http://localhost:8080/realms/livelearn/protocol/openid-connect/auth",
    "TokenUrl": "http://localhost:8080/realms/livelearn/protocol/openid-connect/token"
  },
  "RabbitMQ": {
    "Host": "rabbitmq"
  },
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "Storage": {
    "ServiceURL": "http://localhost:9000",
    "RawVideosBucket": "videos-raw",
    "UploadUrlTtlMinutes": 10
  },
  "WatchTicket": {
    "Issuer": "livelearn-catalog",
    "Audience": "livelearn-streaming",
    "TtlMinutes": 3
  }
}