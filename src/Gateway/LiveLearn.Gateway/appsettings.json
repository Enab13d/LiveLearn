{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        // downstream cluster
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          // ingress request path
          "Path": "/catalog/{**remainder}"
        },
        "Transforms": [
          //downstream path
          { "PathPattern": "/api/{**remainder}" }
        ]
      }

      // "enrollment-route": { ... }
      // "payment-route":    { ... }
      // "streaming-route":  { ... }
      // "notification-route": { ... }
      // "certificate-route":  { ... }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            // docker DNS service name
            "Address": "http://catalog-service:8080/"
          }
        }
      }

      // "enrollment-cluster":   { ... }
      // "payment-cluster":      { ... }
      // "streaming-cluster":    { ... }
      // "notification-cluster": { ... }
      // "certificate-cluster":  { ... }
    }
  }
}
