{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        // downstream cluster
        "ClusterId": "catalog-cluster",
        "Match": {
          // ingress request path
          "Path": "/catalog/{**remainder}"
        },
        "Transforms": [
          //downstream path (1:1 passthrough — controllers already own the "api/" segment)
          { "PathPattern": "/{**remainder}" }
        ]
      },
      "catalog-openapi-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/catalog/openapi/{**remainder}" },
        "Transforms": [{ "PathPattern": "/openapi/{**remainder}" }]
      },
      "catalog-health-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/catalog/health" },
        "Transforms": [{ "PathPattern": "/health" }]
      },
      "enrollment-route": {
        "ClusterId": "enrollment-cluster",
        "AuthorizationPolicy": "onlyAuthenticated",
        "Match": {
          "Path": "/enrollment/{**remainder}"
        },
        "Transforms": [{ "PathPattern": "/{**remainder}" }]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "onlyAuthenticated",
        "Match": {
          "Path": "/payment/{**remainder}"
        },
        "Transforms": [{ "PathPattern": "/{**remainder}" }]
      },
      "streaming-route": {
        "ClusterId": "streaming-cluster",
        "AuthorizationPolicy": "onlyAuthenticated",
        "Match": {
          "Path": "/streaming/{**remainder}"
        },
        "Transforms": [{ "PathPattern": "/{**remainder}" }]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "onlyAuthenticated",
        "Match": {
          "Path": "/notification/{**remainder}"
        },
        "Transforms": [{ "PathPattern": "/{**remainder}" }]
      },
      "certificate-route": {
        "ClusterId": "certificate-cluster",
        "AuthorizationPolicy": "onlyAuthenticated",
        "Match": { "Path": "/certificate/{**remainder}" },
        "Transforms": [{ "PathPattern": "/{**remainder}" }]
      },
      "identity-openapi-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/identity/openapi/{**remainder}" },
        "Transforms": [{ "PathPattern": "/openapi/{**remainder}" }]
      },
      "identity-health-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/identity/health" },
        "Transforms": [{ "PathPattern": "/health" }]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "onlyAuthenticated",
        "Match": { "Path": "/identity/{**remainder}" },
        "Transforms": [{ "PathPattern": "/{**remainder}" }]
      },
      "assessment-route": {
        "ClusterId": "assessment-cluster",
        "AuthorizationPolicy": "onlyAuthenticated",
        "Match": {
          "Path": "/assessment/{**remainder}"
        },
        "Transforms": [{ "PathPattern": "/{**remainder}" }]
      },
      "assessment-openapi-route": {
        "ClusterId": "assessment-cluster",
        "Match": { "Path": "/assessment/openapi/{**remainder}" },
        "Transforms": [{ "PathPattern": "/openapi/{**remainder}" }]
      },
      "assessment-health-route": {
        "ClusterId": "assessment-cluster",
        "Match": { "Path": "/assessment/health" },
        "Transforms": [{ "PathPattern": "/health" }]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            // docker DNS service name
            "Address": "http://catalog-service:8080/"
          }
        }
      },

      "enrollment-cluster": {
        "Destinations": {
          "enrollment": {
            "Address": "http://enrollment-service:8080/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment": {
            "Address": "http://payment-service:8080/"
          }
        }
      },
      "streaming-cluster": {
        "Destinations": {
          "streaming": {
            "Address": "http://streaming-service:8080/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": {
            "Address": "http://notification-service:8080/"
          }
        }
      },
      "certificate-cluster": {
        "Destinations": {
          "certificate": {
            "Address": "http://certificate-service:8080/"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://identity-service:8080/"
          }
        }
      },
      "assessment-cluster": {
        "Destinations": {
          "assessment": {
            "Address": "http://assessment-service:8080/"
          }
        }
      }
    }
  }
}
